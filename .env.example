# Copy this file to .env and adjust values.
# Used by docker-compose.yml (backend container).

# MongoDB connection string (service name `mongodb` inside Docker, localhost for local runs)
MONGODB_URI=mongodb://mongodb:27017

# Database name for development data
DATABASE_NAME=fullstack_web_lab

# Secret used to sign JWTs - CHANGE THIS in production
JWT_SECRET=change_this_secret_to_a_long_random_string
JWT_ALGORITHM=HS256

# Token lifetime in minutes (1 day default)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed browser origins (Flutter web dev server, nginx, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8765,http://127.0.0.1:3000

# Simple per-IP rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Credentials used by the seed script for the demo admin account
SEED_ADMIN_EMAIL=admin@weblab.local
SEED_ADMIN_PASSWORD=Admin@123