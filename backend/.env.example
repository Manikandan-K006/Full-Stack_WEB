# Copy this file to .env and fill in your values
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=fullstack_web_lab
JWT_SECRET=change_this_secret_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Optional: set a seed password for admin created by the seed script
SEED_ADMIN_EMAIL=admin@weblab.local
SEED_ADMIN_PASSWORD=Admin@123
